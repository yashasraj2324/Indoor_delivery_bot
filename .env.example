# Copy to .env and fill in values before running

# Environment
APP_ENV=development
DEBUG=false
RUN_MIGRATIONS_ON_STARTUP=false
CORS_ORIGINS=
APP_PORT=8000

# Database (local Docker example)
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/robot_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — generate a random value locally; production requires 32+ characters
# JWT_SECRET=<openssl rand -hex 32>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Legacy setting; the v1 gateway authenticates per-robot keys stored as bcrypt hashes.
ROBOT_API_KEY=change-me-robot-key

# Goal commands are enabled by default. Set false to disable dispatch.
ROBOT_COMMAND_CHANNEL_ENABLED=true
ROBOT_COMMAND_TTL_S=15
ROBOT_COMMAND_ACK_TIMEOUT_S=5

# First admin bootstrap only. Set both for the initial startup, then remove.
# ADMIN_EMAIL=<administrator email>
# ADMIN_PASSWORD=<unique password of at least 14 characters>

# ROS transport is opt-in; keep disabled for cloud-only deployments.
ROSBRIDGE_ENABLED=false
# Optional local-development default. The admin console can select an
# RFC1918 robot address at runtime when ROSBRIDGE_ENABLED=true.
ROSBRIDGE_URL=ws://localhost:9090

# App
